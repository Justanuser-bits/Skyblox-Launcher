<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\SkybloxLogo.ico</ApplicationIcon>
    <AssemblyName>SkybloxLauncher</AssemblyName>
    <RootNamespace>SkybloxLauncher</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- macOS Info.plist configuration -->
    <CFBundleName>SkybloxLauncher</CFBundleName>
    <CFBundleDisplayName>Skyblox Launcher</CFBundleDisplayName>
    <CFBundleIdentifier>co.skyblox.launcher</CFBundleIdentifier>
    <CFBundleVersion>1.0.6</CFBundleVersion>
    <CFBundlePackageType>APPL</CFBundlePackageType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Skyblox_logo.png" />
    <AvaloniaResource Include="Resources\SkybloxLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
  </ItemGroup>
</Project>
