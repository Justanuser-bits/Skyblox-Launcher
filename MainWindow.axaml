<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SkybloxLauncher.MainWindow"
        Title="Skyblox Launcher"
        Width="440" Height="280"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">

    <Panel Name="RootPanel" Background="Transparent" PointerPressed="OnPointerPressed">
        <!-- Close Button (✕) -->
        <Button Name="CloseBtn" Content="✕"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,12,0"
                Background="Transparent" BorderThickness="0"
                FontSize="14" FontWeight="Bold"
                Cursor="Hand" Click="OnCloseClick" />

        <!-- Main Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,10,0,0">
            <!-- Skyblox Logo -->
            <Image Name="LogoImage" Width="180" Height="85"
                   Source="avares://SkybloxLauncher/Resources/Skyblox_logo.png"
                   Cursor="Hand" PointerPressed="OnLogoClick" />

            <!-- Status Label -->
            <TextBlock Name="StatusLabel"
                       Text="Checking for updates..."
                       FontSize="13" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Width="380" Height="42" />

            <!-- Progress Bar -->
            <ProgressBar Name="ProgressBar"
                         Width="300" Height="6" CornerRadius="3"
                         IsIndeterminate="True" />
        </StackPanel>

        <!-- Footer Area -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Spacing="2">
            <TextBlock Name="RepairLink" Text="Repair"
                       FontSize="11" TextDecorations="Underline"
                       Foreground="#4A90E2" Cursor="Hand"
                       TextAlignment="Center" PointerPressed="OnRepairClick" />
            <TextBlock Name="VersionFooter" Text="v1.0.6"
                       FontSize="10" Foreground="Gray"
                       TextAlignment="Center" />
        </StackPanel>
    </Panel>
</Window>
